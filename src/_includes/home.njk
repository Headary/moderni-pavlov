{% extends "base.njk" %}

{% block content %}
<header class="hero-section text-white py-5">
    <div class="hero-media">
        <img class="" src="/assets/pavlov.jpg" alt="" loading="eager" fetchpriority="high">
    </div>

    <div class="container text-center">
        <h1 class="display-3 fw-bold mb-2">Moderní Pavlov</h1>
        <p class="lead mb-2">Sdružení nezávislých kandidátů</p>
        <p class="subtitle-text mb-4">Představujeme vizi čistší, bezpečnější a progresivnější obce</p>

        <div class="cta-buttons d-flex gap-3 justify-content-center flex-wrap mt-4">
            <a href="/program/" class="btn btn-light btn-lg fw-bold">Náš Program</a>
            <a href="/kandidati/" class="btn btn-light btn-lg fw-bold">Kandidáti</a>
        </div>
    </div>
</header>
<main class="container py-5">{{ content | safe }}</main>
{% endblock %}

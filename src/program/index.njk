---
title: Program
permalink: /program/
---

{% for program in collections.program %}

<div class="card mb-3">
  <div class="row g-0">
    <!-- Image Column -->
    <div class="col-lg-2 col-md-3">
      <img src="{{ program.data.image }}" class="img-fluid h-100 object-fit-cover" alt="{{ program.data.title }}">
    </div>
    <!-- Content Column -->
    <div class="col-md-9 col-lg-10">
      <div class="card-body d-flex flex-column">
        <h4 class="card-title text-primary">{{ program.data.title }}</h4>
        <div class="card-text flex-grow-1">
          {{ program.content | safe }}
        </div>
      </div>
    </div>
  </div>
</div>

{% endfor %}
